# Zippy Logistics Platform - Environment Variables Example
# Copy this file to .env and update with your actual values

# ===========================================
# Database Configuration
# ===========================================
POSTGRES_DB=zippydb
POSTGRES_USER=zippy
POSTGRES_PASSWORD=zippy
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database URL for Spring Boot (assembled from above)
# Format: jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/zippydb

# ===========================================
# Backend Service Configuration
# ===========================================
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker

# JVM Options for backend
JAVA_OPTS=-Xmx512m -Xms256m

# ===========================================
# Mock Courier Service Configuration
# ===========================================
MOCK_COURIER_PORT=8081
ZIPPY_BACKEND_HOST=zippy-backend

# ===========================================
# Frontend Configuration
# ===========================================
FRONTEND_PORT=3000
NODE_ENV=production

# Backend API URL for frontend (used in Docker)
VITE_API_BASE_URL=http://localhost:8080

# ===========================================
# Courier API Base URLs
# ===========================================
# These are configured in application-docker.yml
# Local development uses localhost:8081 for all
FASTSHIP_BASE_URL=http://mock-courier-service:8081
QUICKEXPRESS_BASE_URL=http://mock-courier-service:8081
RELIABLE_BASE_URL=http://mock-courier-service:8081

# ===========================================
# Logging Configuration
# ===========================================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_ZIPPY=DEBUG

# ===========================================
# Actuator/Health Check Configuration
# ===========================================
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when-authorized

# ===========================================
# Security Configuration (Future)
# ===========================================
# JWT_SECRET=your-secret-key
# JWT_EXPIRATION=86400000
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# ===========================================
# Production Overrides (Future)
# ===========================================
# Use external managed database in production
# POSTGRES_HOST=your-rds-endpoint.amazonaws.com
# POSTGRES_PORT=5432
# POSTGRES_DB=zippy_production
# POSTGRES_USER=zippy_prod_user
# POSTGRES_PASSWORD=strong-password-here

# Use actual courier API endpoints in production
# FASTSHIP_BASE_URL=https://api.fastship.com
# QUICKEXPRESS_BASE_URL=https://api.quickexpress.com
# RELIABLE_BASE_URL=https://api.reliablecourier.com

# Enable SSL/HTTPS
# SERVER_SSL_ENABLED=true
# SERVER_SSL_KEY_STORE=classpath:keystore.p12
# SERVER_SSL_KEY_STORE_PASSWORD=changeit
